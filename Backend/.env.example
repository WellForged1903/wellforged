# Database Configuration (Supabase or Local PostgreSQL)
DB_USER=your_db_user
DB_HOST=your_db_host
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
DB_PORT=5432
PORT=5001

# Admin Authentication
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=your_secure_jwt_secret

# Razorpay LIVE Details (For Production)
# RAZORPAY_KEY_ID=rzp_live_your_live_key
# RAZORPAY_KEY_SECRET=your_live_secret_key

# Razorpay TEST Details (For Development)
RAZORPAY_KEY_ID=rzp_test_your_test_key
RAZORPAY_KEY_SECRET=your_test_secret_key

# Email Configuration (Brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=hello@yourdomain.com
BREVO_FROM_NAME=YourBrand
BREVO_REPLY_TO_EMAIL=hello@yourdomain.com
BREVO_REPLY_TO_NAME=YourBrand

# Supabase Storage (For Product Images)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=product-images
